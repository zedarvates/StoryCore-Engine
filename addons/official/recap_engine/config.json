{
  "output_dir": "data/assets/recaps",
  "comic_output_dir": "data/assets/comics",
  "ffmpeg_path": "ffmpeg",
  "default_tts_provider": "gtts",
  "default_language": "fr",
  "default_style": "manga_recap",
  "default_resolution": "1920x1080",
  "default_fps": 30,
  "scene_defaults": {
    "min_duration": 3.0,
    "max_duration": 12.0,
    "default_duration": 5.0,
    "transition_duration": 0.5,
    "camera_intensity": 0.08,
    "background_music_volume": 0.15
  },
  "tts": {
    "gtts": {
      "enabled": true,
      "slow": false
    },
    "edge_tts": {
      "enabled": true,
      "default_voice_fr": "fr-FR-DeniseNeural",
      "default_voice_en": "en-US-JennyNeural"
    },
    "piper": {
      "enabled": false,
      "executable": "piper",
      "model_dir": "models/piper"
    },
    "elevenlabs": {
      "enabled": false,
      "api_key_env": "ELEVENLABS_API_KEY"
    }
  },
  "render": {
    "preset": "fast",
    "crf": 23,
    "audio_bitrate": "128k",
    "pixel_format": "yuv420p",
    "max_concurrent_scenes": 4
  }
}
