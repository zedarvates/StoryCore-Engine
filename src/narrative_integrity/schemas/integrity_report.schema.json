{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storycore.local/schemas/narrative_integrity/integrity_report.schema.json",
  "title": "NarrativeIntegrityReport",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "project_id",
    "input_ref",
    "scope",
    "settings_ref",
    "aggregates",
    "confidence",
    "confidence_reason",
    "created_at",
    "layers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 8
    },
    "project_id": {
      "type": "string"
    },
    "canon_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_ref": {
      "type": "object",
      "required": [
        "artifact",
        "content_sha256",
        "chars",
        "scanned_chars",
        "words",
        "truncated"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "minLength": 8
        },
        "chars": {
          "type": "integer",
          "minimum": 0
        },
        "scanned_chars": {
          "type": "integer",
          "minimum": 0
        },
        "words": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "layer",
          "status",
          "families"
        ],
        "properties": {
          "layer": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "S"
            ]
          },
          "status": {
            "enum": [
              "ran",
              "partial",
              "skipped"
            ]
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "settings_ref": {
      "type": "object",
      "required": [
        "name",
        "schema_version",
        "sha256"
      ]
    },
    "aggregates": {
      "type": "object",
      "required": [
        "findings_total",
        "by_layer",
        "by_severity",
        "blocked"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence_reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "minLength": 8
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "layer",
          "status",
          "determinism",
          "metrics",
          "findings"
        ],
        "properties": {
          "layer": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "S"
            ]
          },
          "status": {
            "enum": [
              "ran",
              "partial",
              "skipped"
            ]
          },
          "note": {
            "type": "string"
          },
          "determinism": {
            "enum": [
              "deterministic",
              "statistical",
              "probabilistic"
            ]
          },
          "metrics": {
            "type": "object"
          },
          "findings": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://storycore.local/schemas/narrative_integrity/finding.schema.json",
              "title": "NarrativeIntegrityFinding",
              "type": "object",
              "required": [
                "finding_id",
                "layer",
                "control_family",
                "detector_id",
                "severity",
                "determinism",
                "confidence",
                "confidence_basis",
                "locus",
                "evidence",
                "applied"
              ],
              "properties": {
                "finding_id": {
                  "type": "string",
                  "minLength": 8
                },
                "layer": {
                  "enum": [
                    "L0",
                    "L1",
                    "L2",
                    "L3",
                    "S"
                  ]
                },
                "control_family": {
                  "enum": [
                    "deterministic",
                    "statistical",
                    "relational",
                    "llm_judge"
                  ]
                },
                "detector_id": {
                  "type": "string",
                  "minLength": 3
                },
                "severity": {
                  "enum": [
                    "info",
                    "low",
                    "medium",
                    "high",
                    "blocking"
                  ]
                },
                "determinism": {
                  "enum": [
                    "deterministic",
                    "statistical",
                    "probabilistic"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "confidence_basis": {
                  "type": "string"
                },
                "locus": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "excerpt",
                      "locus",
                      "detail"
                    ],
                    "properties": {
                      "excerpt": {
                        "type": "string"
                      },
                      "locus": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "canon_conflict": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "remediation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "applied": {
                  "const": false
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
