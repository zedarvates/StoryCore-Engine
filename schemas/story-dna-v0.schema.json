{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://storycore.local/schemas/story-dna-v0.schema.json",
  "title":"Story DNA v0 experimental","type":"object",
  "required":["schema_version","story_id","entities","events"],
  "properties":{
    "schema_version":{"const":"0.1-experimental"},
    "story_id":{"type":"string"},
    "title":{"type":"string"},
    "entities":{"type":"array","items":{"type":"object","required":["id","type"],"properties":{"id":{"type":"string"},"type":{"enum":["character","place","faction","object","concept"]},"traits":{"type":"object"}},"additionalProperties":true}},
    "events":{"type":"array","items":{"type":"object","required":["id"],"properties":{"id":{"type":"string"},"participants":{"type":"array","items":{"type":"string"}},"causes":{"type":"array","items":{"type":"string"}},"consequences":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}},
    "relationships":{"type":"array","items":{"type":"object"}},
    "arcs":{"type":"array","items":{"type":"object"}},
    "open_questions":{"type":"array","items":{"type":"string"}}
  },"additionalProperties":true
}